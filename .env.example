# Configuration NLP — copie ce fichier en .env à la racine et remplis les valeurs.
# Le .env n'est PAS versionné (voir .gitignore). Chargé automatiquement par scripts/run.py.

# --- Provider OpenAI-compatible (nouslabs / Nous Research) ---
LSF_NLP_PROVIDER=openai
# URL de base de ton compte nouslabs (doit finir par /v1)
LSF_NLP_BASE_URL=https://inference-api.nousresearch.com/v1
# ID exact du modèle (catalogue Nous Portal, préfixé par provider).
# nousresearch/hermes-4-70b = le moins cher des modèles natifs Nous.
# Autres : anthropic/claude-sonnet-4.6, openai/gpt-5.5-pro, deepseek/deepseek-v4-pro
LSF_NLP_MODEL=nousresearch/hermes-4-70b
# Ta clé API nouslabs
LSF_NLP_API_KEY=sk-...

# --- Alternative : backend Anthropic (Claude) ---
# LSF_NLP_PROVIDER=anthropic
# LSF_NLP_API_KEY=sk-ant-...
# (ou ANTHROPIC_API_KEY=sk-ant-...)
